---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import VideoSection from '../components/VideoSection.astro';
import StatsStrip from '../components/StatsStrip.astro';
import Features from '../components/Features.astro';
import Products from '../components/Products.astro';
import AlternativesSection from '../components/AlternativesSection.astro';
import FamilySection from '../components/FamilySection.astro';
import FaqSection from '../components/FaqSection.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout>
  <Header />
  <main id="main">
    <Hero />
    <VideoSection />
    <StatsStrip />
    <Features />
    <Products />
    <AlternativesSection />
    <FamilySection />
    <FaqSection />
  </main>
  <Footer />
</BaseLayout>
