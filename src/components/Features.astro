---
import { features } from '../data/site';
---

<section id="why-apowus" class="section-padding scroll-mt-20">
  <div class="container-main">
    <div class="mx-auto max-w-2xl text-center">
      <p class="eyebrow">Why APOWUS</p>
      <h2 class="section-title mt-4">Why choose the APOWUS portable nebulizer?</h2>
      <p class="section-lead mx-auto">
        A quick look at what the APOWUS Portable Nebulizer is designed for — full specs are confirmed
        on the live product listing when availability returns.
      </p>
    </div>

    <div class="mt-14 grid gap-6 md:grid-cols-3">
      {
        features.map((feature) => (
          <article class="card-modern text-center">
            <div class="mx-auto mb-5 flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-brand-1 to-brand-2 text-white shadow-lg shadow-brand-2/20">
              {feature.icon === 'droplet' && (
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 384 512" width="24" height="24" aria-hidden="true" class="fill-current">
                  <path d="M192 512C86 512 0 426 0 320C0 228.8 130.2 57.7 172.8 5.7c5-6.1 12.3-9.7 20-9.7s15 3.6 20 9.7C255.8 57.7 384 228.8 384 320c0 106-86 192-192 192z" />
                </svg>
              )}
              {feature.icon === 'wallet' && (
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="24" height="24" aria-hidden="true" class="fill-current">
                  <path d="M64 32C28.7 32 0 60.7 0 96V416c0 35.3 28.7 64 64 64H448c35.3 0 64-28.7 64-64V192c0-35.3-28.7-64-64-64H80c-8.8 0-16-7.2-16-16s7.2-16 16-16H448c17.7 0 32-14.3 32-32s-14.3-32-32-32H64zM416 272a32 32 0 1 1 0 64 32 32 0 1 1 0-64z" />
                </svg>
              )}
              {feature.icon === 'home' && (
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="24" height="24" aria-hidden="true" class="fill-current">
                  <path d="M0 224c0 17.7 14.3 32 32 32h32V416c0 35.3 28.7 64 64 64H384c35.3 0 64-28.7 64-64V256h32c17.7 0 32-14.3 32-32c0-9.5-4.2-18.5-11.5-24.6l-192-160c-11.9-9.9-29.1-9.9-41 0l-192 160C4.2 205.5 0 214.5 0 224zm128 40l128-106.7L384 264V416H320V320c0-17.7-14.3-32-32-32H224c-17.7 0-32 14.3-32 32v96H128V264z" />
                </svg>
              )}
            </div>
            <h3 class="text-xl font-semibold text-brand-3">{feature.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-brand-4/75">{feature.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
