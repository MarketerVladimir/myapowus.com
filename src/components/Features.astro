---
import { features } from '../data/site';
---

<section id="about" class="section-padding scroll-mt-20">
  <div class="container-main">
    <div class="mx-auto max-w-2xl text-center">
      <p class="eyebrow">Why APOWUS</p>
      <h2 class="section-title mt-4">Designed for real life, not hospital hallways</h2>
      <p class="section-lead mx-auto">
        Quiet mesh technology, intuitive controls, and a form factor that fits your pocket — built for families managing asthma, COPD, and everyday respiratory care.
      </p>
    </div>

    <div class="mt-14 grid gap-6 md:grid-cols-3">
      {
        features.map((feature) => (
          <article class="card-modern text-center">
            <div class="mx-auto mb-5 flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-brand-1 to-brand-2 text-white shadow-lg shadow-brand-2/20">
              {feature.icon === 'home' && (
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 576 512" width="26" height="26" aria-hidden="true" class="fill-current">
                  <path d="M543.8 287.6c17 0 32-14 32-32.1c1-9-3-17-11-24L512 185V64c0-17.7-14.3-32-32-32H448c-17.7 0-32 14.3-32 32v36.7L309.5 7c-6-5-14-7-21-7s-15 1-22 8L10 231.5c-7 7-10 15-10 24c0 18 14 32.1 32 32.1h32V448c0 35.3 28.7 64 64 64H448.5c35.5 0 64.2-28.8 64-64.3l-.7-160.2h32zM288 160a64 64 0 1 1 0 128 64 64 0 1 1 0-128zM176 400c0-44.2 35.8-80 80-80h64c44.2 0 80 35.8 80 80c0 8.8-7.2 16-16 16H192c-8.8 0-16-7.2-16-16z" />
                </svg>
              )}
              {feature.icon === 'users' && (
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 512" width="26" height="26" aria-hidden="true" class="fill-current">
                  <path d="M144 160A80 80 0 1 0 144 0a80 80 0 1 0 0 160zm368 0A80 80 0 1 0 512 0a80 80 0 1 0 0 160zM0 298.7C0 310.4 9.6 320 21.3 320H234.7c.2 0 .4 0 .7 0c-26.6-23.5-43.3-57.8-43.3-96c0-7.6 .7-15 1.9-22.3c-13.6-6.3-28.7-9.7-44.6-9.7H106.7C47.8 192 0 239.8 0 298.7zM320 320c24 0 45.9-8.8 62.7-23.3c2.5-3.7 5.2-7.3 8-10.7c2.7-3.3 5.7-6.1 9-8.3C410 262.3 416 243.9 416 224c0-53-43-96-96-96s-96 43-96 96s43 96 96 96z" />
                </svg>
              )}
              {feature.icon === 'wallet' && (
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="26" height="26" aria-hidden="true" class="fill-current">
                  <path d="M64 32C28.7 32 0 60.7 0 96V416c0 35.3 28.7 64 64 64H448c35.3 0 64-28.7 64-64V192c0-35.3-28.7-64-64-64H80c-8.8 0-16-7.2-16-16s7.2-16 16-16H448c17.7 0 32-14.3 32-32s-14.3-32-32-32H64zM416 272a32 32 0 1 1 0 64 32 32 0 1 1 0-64z" />
                </svg>
              )}
            </div>
            <h3 class="text-xl font-semibold text-brand-3">{feature.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-brand-4/75">{feature.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
