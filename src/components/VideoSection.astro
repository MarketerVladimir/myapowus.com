---
const videoSrc = '/videos/promo.mp4';
const posterSrc = '/images/apowus/video-poster.jpg';
---

<section id="video" class="section-padding scroll-mt-20 bg-brand-6">
  <div class="container-main">
    <div class="mx-auto max-w-2xl text-center">
      <p class="eyebrow">Product video</p>
      <h2 class="section-title mt-4">See the APOWUS Portable Nebulizer in action</h2>
      <p class="section-lead mx-auto">
        Watch how the APOWUS Portable Nebulizer works at home.
      </p>
    </div>

    <div class="mx-auto mt-12 max-w-5xl overflow-hidden rounded-3xl border border-brand-5 bg-white shadow-[0_20px_60px_-30px_rgba(10,33,23,0.25)]">
      <video
        class="aspect-video w-full bg-black object-cover"
        src={videoSrc}
        controls
        playsinline
        preload="metadata"
        poster={posterSrc}
      >
        <track kind="captions" />
        Your browser does not support embedded video. <a href={videoSrc}>Download the video</a>.
      </video>
    </div>
  </div>
</section>
