---
import ProductCard from './ProductCard.astro';
import { products } from '../data/site';
---

<section id="products" class="scroll-mt-20 section-padding">
  <div class="container-main">
    <div class="mx-auto max-w-2xl text-center">
      <p class="eyebrow">Compare</p>
      <h2 class="section-title mt-4">Currently available alternatives</h2>
      <p class="section-lead mx-auto">
        Real, currently-sold models we found on Amazon.com — no invented specs, no fabricated prices.
      </p>
    </div>

    <div class="mt-14 grid gap-6 md:grid-cols-3">
      {products.map((product) => <ProductCard {...product} />)}
    </div>
  </div>
</section>
