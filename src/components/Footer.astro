---
import { Image } from 'astro:assets';
import { navLinks, site, products } from '../data/site';
import { AFFILIATE_DISCLOSURE } from '../config/site';
import logoWhite from '../assets/logo-white.png';

/** Baked in at build time; the inline script below corrects it if the year has rolled over. */
const buildYear = new Date().getFullYear();
const brands = [...new Set(products.map((p) => p.brand))];
---

<footer class="mt-8 bg-brand-3 text-white">
  <div class="container-main grid gap-10 py-14 md:grid-cols-2 lg:grid-cols-4">
    <div class="lg:col-span-1">
      <Image
        src={logoWhite}
        alt="APOWUS logo"
        width={40}
        height={40}
        densities={[1, 2]}
        format="webp"
        class="h-10 w-10"
        loading="lazy"
      />
      <p class="mt-4 text-sm leading-relaxed text-white/70">
        {site.notAffiliated} APOWUS, {brands.join(' and ')} are trademarks of their respective owners.
      </p>
    </div>

    <div>
      <h4 class="text-sm font-semibold uppercase tracking-wider text-white/90">Explore</h4>
      <ul class="mt-4 space-y-2">
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-white/70 transition hover:text-white">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h4 class="text-sm font-semibold uppercase tracking-wider text-white/90">Brands covered</h4>
      <ul class="mt-4 space-y-2 text-sm text-white/70">
        {brands.map((brand) => <li>{brand}</li>)}
      </ul>
    </div>

    <div>
      <h4 class="text-sm font-semibold uppercase tracking-wider text-white/90">Support</h4>
      <p class="mt-4 text-sm text-white/70">
        We don't sell or ship these products, so we can't help with orders or warranty claims. For
        support, contact the seller through your Amazon order page.
      </p>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-main py-5">
      <p class="text-xs leading-relaxed text-white/55">{AFFILIATE_DISCLOSURE}</p>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-main py-5 text-center text-sm text-white/60">
      <p>Copyright © <span data-current-year>{buildYear}</span> - {site.copyrightOwner}</p>
    </div>
  </div>
</footer>

<script>
  // The build-time year is correct until New Year's Eve of a year with no deploy.
  // This keeps it right without waiting for a rebuild.
  const slot = document.querySelector<HTMLElement>('[data-current-year]');
  const now = String(new Date().getFullYear());
  if (slot && slot.textContent !== now) slot.textContent = now;
</script>
