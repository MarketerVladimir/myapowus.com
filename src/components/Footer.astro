---
import { Image } from 'astro:assets';
import { footerLegal, navLinks, site } from '../data/site';
import logoWhite from '../assets/logo-white.png';

const buildYear = new Date().getFullYear();
---

<footer class="mt-4 bg-brand-3 text-white">
  <div class="container-main pt-10 pb-6">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between sm:gap-8">
      <div class="flex items-start gap-3">
        <Image
          src={logoWhite}
          alt="APOWUS logo"
          width={40}
          height={40}
          densities={[1, 2]}
          format="webp"
          class="h-10 w-10 shrink-0"
          loading="lazy"
        />
        <div>
          <p class="text-sm font-semibold leading-snug text-white md:text-base">{site.name}</p>
          <p class="mt-1.5 inline-flex rounded-full border border-white/15 bg-white/5 px-2.5 py-0.5 text-xs text-white/60">
            Official website
          </p>
        </div>
      </div>

      <nav
        class="flex max-w-full flex-wrap gap-x-3 gap-y-2 text-sm sm:justify-end"
        aria-label="Footer navigation"
      >
        {
          navLinks.map((link, index) => (
            <>
              {index > 0 && (
                <span class="hidden text-white/30 sm:inline" aria-hidden="true">
                  ·
                </span>
              )}
              <a
                href={link.href}
                class="text-white/75 underline-offset-4 transition hover:text-white hover:underline focus-visible:rounded focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
              >
                {link.label}
              </a>
            </>
          ))
        }
      </nav>
    </div>

    <div class="my-5 border-t border-white/10" role="presentation"></div>

    <div class="flex flex-col gap-3 text-sm leading-relaxed text-white/70 sm:flex-row sm:items-center sm:justify-between sm:gap-6">
      <p>{footerLegal.affiliate}</p>
      <p class="shrink-0">
        © <span data-current-year>{buildYear}</span> {site.copyrightOwner}. All rights reserved.
      </p>
    </div>
  </div>
</footer>

<script>
  const slot = document.querySelector<HTMLElement>('[data-current-year]');
  const now = String(new Date().getFullYear());
  if (slot && slot.textContent !== now) slot.textContent = now;
</script>
