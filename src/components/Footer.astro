---
import { Image } from 'astro:assets';
import { navLinks, site } from '../data/site';
import { AFFILIATE_DISCLOSURE } from '../config/site';
import logoWhite from '../assets/logo-white.png';
---

<footer class="mt-8 bg-brand-3 text-white">
  <div class="container-main grid gap-10 py-14 md:grid-cols-2 lg:grid-cols-4">
    <div class="lg:col-span-1">
      <Image
        src={logoWhite}
        alt={site.name}
        width={64}
        height={64}
        densities={[1, 2]}
        format="webp"
        class="h-14 w-14"
        loading="lazy"
      />
      <p class="mt-4 text-sm leading-relaxed text-white/70">
        Official APOWUS brand website for portable mesh nebulizers — quiet, effective respiratory care for adults and children.
      </p>
    </div>

    <div>
      <h4 class="text-sm font-semibold uppercase tracking-wider text-white/90">Explore</h4>
      <ul class="mt-4 space-y-2">
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-white/70 transition hover:text-white">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h4 class="text-sm font-semibold uppercase tracking-wider text-white/90">Shop</h4>
      <p class="mt-4 text-sm text-white/70">Available on Amazon.com (US). Set your delivery location to a US address to view listings.</p>
      <a href={site.amazonUrl} target="_blank" rel="noopener noreferrer" class="btn-primary mt-4 !text-xs">
        View on Amazon
      </a>
    </div>

    <div>
      <h4 class="text-sm font-semibold uppercase tracking-wider text-white/90">Support</h4>
      <p class="mt-4 text-sm text-white/70">
        <a href={`tel:${site.phone.replace(/[^\d+]/g, '')}`} class="font-medium text-white hover:underline">
          {site.phone}
        </a>
        <br />
        {site.hours}
      </p>
      <p class="mt-4 text-xs text-white/50">Fast, reliable delivery · Hassle-free returns via Amazon</p>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-main py-5">
      <p class="text-xs leading-relaxed text-white/55">{AFFILIATE_DISCLOSURE}</p>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-main flex flex-col items-center justify-between gap-3 py-5 text-center text-sm text-white/60 md:flex-row md:text-left">
      <p>{site.copyright}</p>
      <p>
        <a href="/llms.txt" class="hover:text-white">llms.txt</a>
        ·
        <a href="/robots.txt" class="hover:text-white">robots.txt</a>
      </p>
    </div>
  </div>
</footer>
