---
import { Image } from 'astro:assets';
import { navLinks, site } from '../data/site';
import logo from '../assets/logo.png';
---

<header class="glass-header sticky top-0 z-50">
  <div class="container-main flex items-center justify-between gap-4 py-3">
    <a href="#top" class="group flex shrink-0 items-center gap-3" aria-label={`${site.name} home`}>
      <Image
        src={logo}
        alt={site.name}
        width={48}
        height={48}
        densities={[1, 2]}
        format="webp"
        class="h-11 w-11 transition group-hover:scale-105"
        loading="eager"
      />
      <div class="hidden sm:block">
        <p class="text-sm font-bold text-brand-3">{site.name}</p>
        <p class="text-xs text-brand-4/60">Official brand site</p>
      </div>
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Main navigation">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="rounded-full px-4 py-2 text-sm font-medium text-brand-4/85 transition hover:bg-brand-6 hover:text-brand-2"
          >
            {link.label}
          </a>
        ))
      }
      <a href={site.amazonUrl} target="_blank" rel="noopener noreferrer" class="btn-primary ml-2 !px-5 !py-2.5 text-xs">
        Shop Amazon
      </a>
    </nav>

    <details class="relative lg:hidden">
      <summary
        class="flex cursor-pointer list-none items-center gap-2 rounded-full border border-brand-5 bg-white px-4 py-2 text-sm font-medium marker:content-none"
        aria-label="Open menu"
      >
        Menu
      </summary>
      <nav
        class="absolute right-0 mt-2 min-w-52 rounded-2xl border border-brand-5 bg-white p-2 shadow-xl"
        aria-label="Mobile navigation"
      >
        {
          navLinks.map((link) => (
            <a href={link.href} class="block rounded-xl px-4 py-2.5 text-sm font-medium hover:bg-brand-6">
              {link.label}
            </a>
          ))
        }
        <a
          href={site.amazonUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary mt-2 w-full !text-xs"
        >
          Shop Amazon
        </a>
      </nav>
    </details>
  </div>
</header>
