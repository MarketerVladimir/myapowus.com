---
import { about } from '../data/site';

const whySection = about.sections[1];
---

<section class="section-padding">
  <div class="container-main">
    <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
      <div class="lg:sticky lg:top-28">
        <p class="eyebrow">About APOWUS</p>
        <h2 class="section-title mt-4">{about.title}</h2>
        <p class="section-lead">{about.intro}</p>
      </div>

      <div class="space-y-8">
        <article class="card-modern">
          <h3 class="text-xl font-semibold text-brand-2">{about.sections[0].heading}</h3>
          <p class="mt-3 leading-relaxed text-brand-4/80">{about.sections[0].text}</p>
        </article>

        <article class="card-modern">
          <h3 class="text-xl font-semibold text-brand-2">{whySection.heading}</h3>
          <div class="mt-6 space-y-5">
            {
              'items' in whySection &&
                whySection.items.map((item) => (
                  <div class="border-l-2 border-brand-1/50 pl-4">
                    <h4 class="font-semibold text-brand-3">{item.title}</h4>
                    <p class="mt-1 text-sm leading-relaxed text-brand-4/75">{item.text}</p>
                  </div>
                ))
            }
          </div>
        </article>

        <article class="card-modern bg-gradient-to-br from-brand-6 to-white">
          <h3 class="text-xl font-semibold text-brand-2">{about.sections[2].heading}</h3>
          <p class="mt-3 leading-relaxed text-brand-4/80">{about.sections[2].text}</p>
        </article>
      </div>
    </div>
  </div>
</section>
