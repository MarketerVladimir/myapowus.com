---
import { about } from '../data/site';
---

<section id="about" class="section-padding">
  <div class="container-main">
    <div class="mx-auto max-w-2xl text-center">
      <p class="eyebrow">About this page</p>
      <h2 class="section-title mt-4">{about.title}</h2>
      <p class="section-lead mx-auto">{about.intro}</p>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {
        about.points.map((point) => (
          <article class="card-modern">
            <h3 class="text-lg font-semibold text-brand-3">{point.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-brand-4/80">{point.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
