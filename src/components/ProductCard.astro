---
import { buyUrl } from '../data/site';
import type { Product } from '../data/site';

type Props = Product;

const { asin, brand, title, text, badge } = Astro.props;
---

<article class="card-modern flex flex-col">
  {badge && <p class="eyebrow mb-4 self-start">{badge}</p>}
  <p class="text-xs font-semibold uppercase tracking-wider text-brand-2">{brand}</p>
  <h3 class="mt-2 text-balance text-xl font-bold leading-snug text-brand-3 md:text-2xl">{title}</h3>
  <p class="mt-4 flex-1 text-pretty leading-relaxed text-brand-4/80">{text}</p>
  <a
    href={buyUrl(asin)}
    target="_blank"
    rel="noopener noreferrer"
    class="btn-primary mt-6 self-start"
    aria-label={`Check ${title} on Amazon`}
  >
    Check on Amazon
  </a>
</article>
