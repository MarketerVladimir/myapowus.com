---
import { Picture } from 'astro:assets';

interface Props {
  title: string;
  text: string;
  image: ImageMetadata;
  imageAlt: string;
  amazonUrl: string;
  badge?: string;
  reverse?: boolean;
}

const {
  title,
  text,
  image,
  imageAlt,
  amazonUrl,
  badge,
  reverse = false,
} = Astro.props;
---

<article class={`grid items-center gap-10 lg:grid-cols-2 lg:gap-14 ${reverse ? 'lg:[&>*:first-child]:order-2' : ''}`}>
  <div class="group relative overflow-hidden rounded-3xl border border-brand-5 bg-white p-3 shadow-xl shadow-brand-3/5">
    <Picture
      src={image}
      formats={['avif', 'webp']}
      widths={[320, 500, 700]}
      sizes="(min-width: 1024px) 500px, (min-width: 640px) 60vw, 90vw"
      alt={imageAlt}
      class="aspect-square w-full rounded-2xl object-cover transition duration-500 group-hover:scale-[1.02]"
    />
  </div>

  <div>
    {badge && <p class="eyebrow mb-4">{badge}</p>}
    <h2 class="text-balance text-2xl font-bold leading-snug text-brand-3 md:text-3xl lg:text-4xl">{title}</h2>
    <p class="mt-5 text-pretty leading-relaxed text-brand-4/80">{text}</p>
    <a
      href={amazonUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="btn-primary mt-8"
      aria-label={`Buy ${title} on Amazon`}
    >
      Buy Now on Amazon
    </a>
  </div>
</article>
