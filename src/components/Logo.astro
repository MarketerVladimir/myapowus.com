---
/**
 * A plain generic mark for this independent guide — deliberately not a copy or
 * near-copy of any brand's logo (this site used to run APOWUS's lung icon,
 * which is not ours to reuse now that we no longer represent that brand).
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 48 48"
  xmlns="http://www.w3.org/2000/svg"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <circle cx="24" cy="24" r="22" stroke="currentColor" stroke-width="2.5" opacity="0.25"></circle>
  <path
    d="M12 27c3-6 6-9 12-9s9 3 12 9"
    stroke="currentColor"
    stroke-width="2.5"
    stroke-linecap="round"
    fill="none"
  ></path>
  <path
    d="M16 33c2-3.5 4.5-5.5 8-5.5s6 2 8 5.5"
    stroke="currentColor"
    stroke-width="2.5"
    stroke-linecap="round"
    fill="none"
    opacity="0.6"
  ></path>
  <circle cx="24" cy="16" r="3" fill="currentColor"></circle>
</svg>
