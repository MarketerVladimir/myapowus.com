---
import { Picture } from 'astro:assets';
import { hero, heroStats, site } from '../data/site';
import heroBackground from '../assets/header-bg.jpg';
---

<section id="top" class="relative isolate overflow-hidden scroll-mt-20">
  <div class="absolute inset-0 -z-10">
    <Picture
      src={heroBackground}
      formats={['avif', 'webp']}
      widths={[640, 960, 1280, 1920]}
      sizes="100vw"
      alt=""
      class="h-full w-full object-cover"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-br from-brand-3/85 via-brand-3/70 to-brand-2/50"></div>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_20%,rgba(129,169,228,0.25),transparent_50%)]"></div>
  </div>

  <div class="container-main grid min-h-[88vh] items-center gap-10 py-20 lg:grid-cols-[1.1fr_0.9fr] lg:py-28">
    <div class="text-white">
      <p class="eyebrow !border-white/20 !bg-white/10 !text-white/90">{hero.eyebrow}</p>
      <h1 class="mt-5 text-balance text-4xl font-bold leading-[1.05] tracking-tight md:text-5xl lg:text-6xl">
        {hero.title}
      </h1>
      <p class="mt-6 max-w-xl text-pretty text-lg leading-relaxed text-white/85 md:text-xl">
        {hero.subtitle}
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href={site.amazonUrl} target="_blank" rel="noopener noreferrer" class="btn-primary">
          {hero.cta}
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" class="fill-current">
            <path d="m15.5 3.5-2 2 5 5.1H0v2.8h18.5l-5 5.1 2 2L24 12z"></path>
          </svg>
        </a>
        <a href="#products" class="btn-secondary !border-white/20 !bg-white/10 !text-white hover:!bg-white/20">
          {hero.ctaSecondary}
        </a>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-3 sm:gap-4">
      {
        heroStats.map((stat) => (
          <div class="rounded-2xl border border-white/15 bg-white/10 p-4 backdrop-blur-md sm:p-5">
            <p class="text-2xl font-bold text-white sm:text-3xl">{stat.value}</p>
            <p class="mt-1 text-sm text-white/75">{stat.label}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
