---
import { hero } from '../data/site';

const heroImage = '/images/apowus/hero-lifestyle.jpg';
---

<section id="top" class="relative isolate overflow-hidden scroll-mt-20">
  <div class="absolute inset-0 -z-10">
    <img
      src={heroImage}
      alt=""
      width="2000"
      height="1125"
      class="h-full w-full object-cover"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-br from-brand-3/85 via-brand-3/70 to-brand-2/50"></div>
    <div
      class="absolute inset-0 bg-[radial-gradient(circle_at_30%_20%,rgba(129,169,228,0.25),transparent_50%)]"
    >
    </div>
  </div>

  <div class="container-main grid min-h-[70vh] items-center gap-10 py-20 lg:py-28">
    <div class="max-w-2xl text-white">
      <p class="eyebrow !border-white/20 !bg-white/10 !text-white/90">{hero.eyebrow}</p>
      <h1 class="mt-5 text-balance text-4xl font-bold leading-[1.05] tracking-tight md:text-5xl lg:text-6xl">
        {hero.title}
      </h1>
      <p class="mt-6 max-w-xl text-pretty text-lg leading-relaxed text-white/85 md:text-xl">
        {hero.subtitle}
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#product" class="btn-primary">
          {hero.cta}
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" class="fill-current">
            <path d="m15.5 3.5-2 2 5 5.1H0v2.8h18.5l-5 5.1 2 2L24 12z"></path>
          </svg>
        </a>
        <a href="#alternatives" class="btn-secondary !border-white/20 !bg-white/10 !text-white hover:!bg-white/20">
          {hero.ctaSecondary}
        </a>
      </div>
    </div>
  </div>
</section>
